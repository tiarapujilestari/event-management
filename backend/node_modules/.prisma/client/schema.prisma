// ================================================
// Event Ticket Booking Platform - Prisma Schema
// Database: PostgreSQL (Neon)
// ================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------- ENUMS -------------------

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER
  PROMOTION
  SYSTEM
  REVIEW
}

// ------------------- MODELS -------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  fullName          String
  role              Role      @default(CUSTOMER)
  isVerified        Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  referralCode      String    @unique
  referredById      String?
  referredBy        User?     @relation("Referrals", fields: [referredById], references: [id])
  referredUsers     User[]    @relation("Referrals")
  refreshToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile             Profile?
  events              Event[]              @relation("OrganizerEvents")
  orders              Order[]
  reviews             Review[]
  wishlist            Wishlist[]
  notifications       Notification[]
  vouchers            Voucher[]            @relation("OrganizerVouchers")
  pointHistories      PointHistory[]
  referralPointsOwned ReferralPoint[]      @relation("PointOwner")
  coupons             Coupon[]
  reports             Report[]
  organizerStats      OrganizerStatistic[]

  @@index([email])
  @@index([referralCode])
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl String?
  phone     String?
  address   String?
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  province  String?
  country   String    @default("Indonesia")
  events    Event[]
  profiles  Profile[]
  createdAt DateTime  @default(now())

  @@map("cities")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  events    Event[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  organizer   User        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  title       String
  slug        String      @unique
  description String
  bannerUrl   String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  cityId      String
  city        City        @relation(fields: [cityId], references: [id])
  venue       String
  latitude    Float?
  longitude   Float?
  startDate   DateTime
  endDate     DateTime
  isFree      Boolean     @default(false)
  maxPurchase Int         @default(4)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  images       EventImage[]
  ticketTypes  TicketType[]
  reviews      Review[]
  wishlistedBy Wishlist[]
  vouchers     Voucher[]
  orders       Order[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([cityId])
  @@index([startDate])
  @@map("events")
}

model EventImage {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl String
  position Int    @default(0)

  @@map("event_images")
}

model TicketType {
  id          String      @id @default(uuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal     @default(0)
  quota       Int
  sold        Int         @default(0)
  description String?
  tickets     Ticket[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventId])
  @@map("ticket_types")
}

model Ticket {
  id           String     @id @default(uuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  orderItemId  String?
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])
  code         String     @unique @default(uuid())
  isUsed       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@map("tickets")
}

model Order {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id])
  invoiceNumber String            @unique
  subtotal      Decimal
  discountTotal Decimal           @default(0)
  pointsUsed    Int               @default(0)
  total         Decimal
  status        TransactionStatus @default(PENDING)
  voucherId     String?
  voucher       Voucher?          @relation(fields: [voucherId], references: [id])
  couponId      String?
  coupon        Coupon?           @relation(fields: [couponId], references: [id])
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items   OrderItem[]
  payment Payment?
  review  Review?

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  price        Decimal
  tickets      Ticket[]

  @@map("order_items")
}

model Payment {
  id              String            @id @default(uuid())
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id])
  midtransOrderId String            @unique
  paymentMethod   String?
  paymentUrl      String?
  status          TransactionStatus @default(PENDING)
  rawResponse     Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("payments")
}

model Review {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  images    String[]
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@map("wishlist")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Voucher {
  id            String       @id @default(uuid())
  organizerId   String
  organizer     User         @relation("OrganizerVouchers", fields: [organizerId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal
  maxDiscount   Decimal?
  minPurchase   Decimal?     @default(0)
  usageLimit    Int          @default(1)
  usedCount     Int          @default(0)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime     @default(now())

  orders Order[]

  @@map("vouchers")
}

model Coupon {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @default(10)
  isUsed        Boolean      @default(false)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  orders        Order[]

  @@map("coupons")
}

model ReferralPoint {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("PointOwner", fields: [ownerId], references: [id])
  points    Int
  isExpired Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("referral_points")
}

model PointHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@map("point_histories")
}

model Discount {
  id            String       @id @default(uuid())
  name          String
  discountType  DiscountType
  discountValue Decimal
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime     @default(now())

  @@map("discounts")
}

model OrganizerStatistic {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  date        DateTime
  revenue     Decimal  @default(0)
  ticketsSold Int      @default(0)
  visitors    Int      @default(0)
  orders      Int      @default(0)

  @@unique([organizerId, date])
  @@map("organizer_statistics")
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  createdAt DateTime @default(now())

  @@map("reports")
}
